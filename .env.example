# GitHub App details (from https://github.com/settings/apps/<your-app>)
GITHUB_APP_ID=123456
GITHUB_ORG=pnszlm-TestPlayground

# Path to the GitHub App private key (PEM). Alternatively set GITHUB_PRIVATE_KEY
# to the raw PEM contents.
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# Optional: installation ID of the App on the org. If left blank, the app
# auto-discovers the first installation for GITHUB_ORG.
GITHUB_INSTALLATION_ID=

# Central repo that hosts the deployment workflow (the repo itself).
GITHUB_CENTRAL_REPO=pnszlm-TestPlayground/Test_CentralisedWorkflows

# Workflow filename in .github/workflows/ that receives the dispatch event.
GITHUB_WORKFLOW_FILE=deploy.yml

# API base URL (override for GitHub Enterprise Server)
GITHUB_API_URL=https://api.github.com
